#include <iostream>
#include <iomanip>
#include <cstdlib>
#include <ctime>

using namespace std;

int main() {
    srand(static_cast<unsigned int>(time(0)));

    const int m = 3, n = 4;
    int arr[m][n];

    cout << "Matrix 3x4:" << endl;
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            arr[i][j] = rand() % 100 - 50; // числа від -50 до 49
            cout << setw(5) << arr[i][j];
        }
        cout << endl;
    }

    int maxVal = arr[0][0];
    int maxRow = 0, maxCol = 0;

    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            if (arr[i][j] > maxVal) {
                maxVal = arr[i][j];
                maxRow = i;
                maxCol = j;
            }
        }
    }

    cout << "\nMax element: " << maxVal << endl;
    cout << "Position: row " << maxRow + 1 << ", column " << maxCol + 1
         << " (indices [" << maxRow << "][" << maxCol << "])" << endl;

    cout << "Press Enter to exit...";
    cin.get();
    return 0;
}
