#include <iostream>
#include <iomanip>
#include <cstdlib>
#include <ctime>

using namespace std;

int main() {
    srand(static_cast<unsigned int>(time(0)));

    const int m = 4, n = 7;
    int arr[m][n];

    cout << "Matrix 4x7:" << endl;
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            arr[i][j] = rand() % 100 - 50;
            cout << setw(5) << arr[i][j];
        }
        cout << endl;
    }

    int minVal = arr[0][0];
    int minRow = 0, minCol = 0;

    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            if (arr[i][j] < minVal) {
                minVal = arr[i][j];
                minRow = i;
                minCol = j;
            }
        }
    }

    cout << "\nMin element: " << minVal << endl;
    cout << "Position: row " << minRow + 1 << ", column " << minCol + 1
         << " (indices [" << minRow << "][" << minCol << "])" << endl;

    cout << "Press Enter to exit...";
    cin.get();
    return 0;
}
