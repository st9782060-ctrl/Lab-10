#include <iostream>
#include <iomanip>
#include <cstdlib>
#include <ctime>

using namespace std;

int main() {
    srand(static_cast<unsigned int>(time(0)));

    const int m = 5, n = 7;
    int arr[m][n];

    cout << "Matrix 5x7:" << endl;
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            arr[i][j] = rand() % 21 - 10;
            cout << setw(5) << arr[i][j];
        }
        cout << endl;
    }

    cout << "\nSum of elements in each row:" << endl;
    for (int i = 0; i < m; i++) {
        int rowSum = 0;
        for (int j = 0; j < n; j++) {
            rowSum += arr[i][j];
        }
        cout << "Row " << i + 1 << ": " << rowSum << endl;
    }

    cout << "Press Enter to exit...";
    cin.get();
    return 0;
}
