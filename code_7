#include <iostream>
#include <iomanip>
#include <cstdlib>
#include <ctime>

using namespace std;

int main() {
    srand(static_cast<unsigned int>(time(0)));

    const int n = 3;
    int arr[n][n];

    cout << "Matrix 3x3:" << endl;
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            arr[i][j] = rand() % 20 + 1; // числа від 1 до 20
            cout << setw(5) << arr[i][j];
        }
        cout << endl;
    }

    int mainDiagSum = 0;      // головна діагональ (i == j)
    int secondaryDiagSum = 0; // побічна діагональ (i + j == n - 1)

    for (int i = 0; i < n; i++) {
        mainDiagSum += arr[i][i];
        secondaryDiagSum += arr[i][n - 1 - i];
    }

    cout << "\nMain diagonal sum: " << mainDiagSum << endl;
    cout << "Secondary diagonal sum: " << secondaryDiagSum << endl;

    cout << "Press Enter to exit...";
    cin.get();
    return 0;
}
