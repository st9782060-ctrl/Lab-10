#include <iostream>
#include <iomanip>
#include <cstdlib>
#include <ctime>

using namespace std;

int main() {
    srand(static_cast<unsigned int>(time(0)));

    const int m = 4, n = 3;
    int arr[m][n];

    cout << "Matrix 4x3:" << endl;
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            arr[i][j] = rand() % 21 - 10; // числа від -10 до 10
            cout << setw(5) << arr[i][j];
        }
        cout << endl;
    }

    cout << "\nEven numbers count in each row:" << endl;
    for (int i = 0; i < m; i++) {
        int evenCount = 0;
        for (int j = 0; j < n; j++) {
            if (arr[i][j] % 2 == 0) {
                evenCount++;
            }
        }
        cout << "Row " << i + 1 << ": " << evenCount << endl;
    }

    cout << "Press Enter to exit...";
    cin.get();
    return 0;
}
